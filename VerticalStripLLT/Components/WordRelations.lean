import Mathlib.Data.Finsupp.Basic
import Mathlib.LinearAlgebra.Quotient.Basic

/-! Contextual additive word relations and descent of linear functionals. -/

namespace VerticalStripLLT.Components

open Set

noncomputable section

abbrev WordModule (V : Type*) := List V →₀ ℤ

variable {V M : Type*} [LinearOrder V]

/-- The basis vector indexed by a word. -/
def basisWord (w : List V) : WordModule V := Finsupp.single w 1

/-- The four-word relation, with arbitrary words on its two sides. -/
def fourWord (ρ σ : List V) (a b c : V) : WordModule V :=
  basisWord (ρ ++ [a, c, b] ++ σ) + basisWord (ρ ++ [b, c, a] ++ σ) -
    basisWord (ρ ++ [c, a, b] ++ σ) - basisWord (ρ ++ [b, a, c] ++ σ)

/-- Generators for the additive word relations. -/
def wordGenerators : Set (WordModule V) :=
  {x | (∃ w, ¬w.Nodup ∧ x = basisWord w) ∨
    ∃ ρ σ a b c, a < b ∧ b < c ∧ x = fourWord ρ σ a b c}

/-- The additive submodule generated by repeated-letter and four-word relations. -/
def wordRelations : Submodule ℤ (WordModule V) :=
  Submodule.span ℤ (wordGenerators : Set (WordModule V))

/-- The additive quotient by the contextual word relations. -/
abbrev WordQuotient (V : Type*) [LinearOrder V] :=
  WordModule V ⧸ wordRelations (V := V)

omit [LinearOrder V] in
theorem basisWord_mem_support (w : List V) : w ∈ (basisWord w).support := by
  classical
  simp [basisWord]

variable [AddCommGroup M] [Module ℤ M]

theorem relations_le_ker
    (f : WordModule V →ₗ[ℤ] M)
    (hrepeated : ∀ w, ¬w.Nodup → f (basisWord w) = 0)
    (hfour : ∀ (ρ σ : List V) (a b c : V), a < b → b < c →
      f (basisWord (ρ ++ [a, c, b] ++ σ)) +
          f (basisWord (ρ ++ [b, c, a] ++ σ)) =
        f (basisWord (ρ ++ [c, a, b] ++ σ)) +
          f (basisWord (ρ ++ [b, a, c] ++ σ))) :
    wordRelations ≤ LinearMap.ker f := by
  rw [wordRelations]
  refine Submodule.span_le.2 ?_
  intro x hx
  change (∃ w, ¬w.Nodup ∧ x = basisWord w) ∨
    ∃ ρ σ a b c, a < b ∧ b < c ∧ x = fourWord ρ σ a b c at hx
  rcases hx with ⟨w, hw, rfl⟩ | ⟨ρ, σ, a, b, c, hab, hbc, rfl⟩
  · exact hrepeated w hw
  · change f (fourWord ρ σ a b c) = 0
    simp only [fourWord, map_add, map_sub]
    rw [hfour ρ σ a b c hab hbc]
    simp

/-- The universal factorization of a functional annihilating the generators. -/
noncomputable def descend
    (f : WordModule V →ₗ[ℤ] M)
    (hrepeated : ∀ w, ¬w.Nodup → f (basisWord w) = 0)
    (hfour : ∀ (ρ σ : List V) (a b c : V), a < b → b < c →
      f (basisWord (ρ ++ [a, c, b] ++ σ)) +
          f (basisWord (ρ ++ [b, c, a] ++ σ)) =
        f (basisWord (ρ ++ [c, a, b] ++ σ)) +
          f (basisWord (ρ ++ [b, a, c] ++ σ))) :
    WordQuotient V →ₗ[ℤ] M :=
  (wordRelations (V := V)).liftQ f (relations_le_ker f hrepeated hfour)

@[simp]
theorem descend_mk
    (f : WordModule V →ₗ[ℤ] M)
    (hrepeated : ∀ w, ¬w.Nodup → f (basisWord w) = 0)
    (hfour : ∀ (ρ σ : List V) (a b c : V), a < b → b < c →
      f (basisWord (ρ ++ [a, c, b] ++ σ)) +
          f (basisWord (ρ ++ [b, c, a] ++ σ)) =
        f (basisWord (ρ ++ [c, a, b] ++ σ)) +
          f (basisWord (ρ ++ [b, a, c] ++ σ)))
    (w : WordModule V) : descend f hrepeated hfour ((wordRelations (V := V)).mkQ w) = f w := by
  rfl

theorem quotient_eq_implies_eq
    (f : WordModule V →ₗ[ℤ] M)
    (hrepeated : ∀ w, ¬w.Nodup → f (basisWord w) = 0)
    (hfour : ∀ (ρ σ : List V) (a b c : V), a < b → b < c →
      f (basisWord (ρ ++ [a, c, b] ++ σ)) +
          f (basisWord (ρ ++ [b, c, a] ++ σ)) =
        f (basisWord (ρ ++ [c, a, b] ++ σ)) +
          f (basisWord (ρ ++ [b, a, c] ++ σ)))
    {x y : WordModule V}
    (hxy : (wordRelations (V := V)).mkQ x = (wordRelations (V := V)).mkQ y) :
    f x = f y := by
  have h := congrArg (descend f hrepeated hfour) hxy
  simpa only [descend_mk] using h

end

end VerticalStripLLT.Components
