import VerticalStripLLT.Components.DiagramProof.Basic
import VerticalStripLLT.Components.FlipTriangle

/-! Actual flips preserve all selected weak blocks, including isolated vertices. -/

namespace VerticalStripLLT.Circular.DiagramProof

open Classical

variable {n : ℕ} {D : Diagram n}

/-- The equivalence relation generated by the actual selected edges. -/
def WeakReach (θ : Orientation D) : Fin n → Fin n → Prop :=
  Relation.EqvGen (D.edgeData.selected θ.val)

/-- Connectivity of the full selected graph on the given vertex set. -/
def SelectedConnected (θ : Orientation D) : Prop := ∀ u v, WeakReach θ u v

theorem weakReach_of_mem (θ : Orientation D) {e : Edge D.area}
    (he : e ∈ fullSelection θ) : WeakReach θ e.tail e.head :=
  Relation.EqvGen.rel _ _ ⟨e, he, rfl, rfl⟩

theorem weakReach_iff_of_directedFlip {θ η : Orientation D}
    (w : DirectedFlipWitness D θ η) (u v : Fin n) : WeakReach θ u v ↔ WeakReach η u v := by
  have hforward : ∀ x y, D.edgeData.selected θ.val x y → WeakReach η x y := by
    rintro x y ⟨e, he, rfl, rfl⟩
    by_cases hab : e = w.eab
    · subst e
      have hac := weakReach_of_mem η w.longEdge_target_mem
      have hbc := weakReach_of_mem η (Finset.mem_union_right _ w.target_bc_mem)
      rw [← w.longEdge_tail, ← w.longEdge_head] at hac
      rw [← w.short_head_tail] at hbc
      exact Relation.EqvGen.trans _ _ _ hac (Relation.EqvGen.symm _ _ hbc)
    · apply weakReach_of_mem η
      change e ∈ D.strict ∪ η.val
      rw [w.full_target_eq_source_swap]
      exact Finset.mem_insert_of_mem (Finset.mem_erase.mpr ⟨hab, he⟩)
  have hbackward : ∀ x y, D.edgeData.selected η.val x y → WeakReach θ x y := by
    rintro x y ⟨e, he, rfl, rfl⟩
    by_cases hbc : e = w.ebc
    · subst e
      have hac := weakReach_of_mem θ w.longEdge_mem
      have hab := weakReach_of_mem θ (Finset.mem_union_right _ w.source_ab_mem)
      rw [← w.longEdge_tail, ← w.longEdge_head] at hac
      change WeakReach θ w.ebc.tail w.ebc.head
      rw [← w.short_head_tail]
      exact Relation.EqvGen.trans _ _ _ (Relation.EqvGen.symm _ _ hab) hac
    · apply weakReach_of_mem θ
      change e ∈ D.strict ∪ η.val at he
      rw [w.full_target_eq_source_swap] at he
      exact (Finset.mem_erase.mp ((Finset.mem_insert.mp he).resolve_left hbc)).2
  change ∀ x y, D.edgeData.selected θ.val x y →
    Relation.EqvGen (D.edgeData.selected η.val) x y at hforward
  change ∀ x y, D.edgeData.selected η.val x y →
    Relation.EqvGen (D.edgeData.selected θ.val) x y at hbackward
  exact ⟨Relation.EqvGen.eqvGen_le hforward u v, Relation.EqvGen.eqvGen_le hbackward u v⟩

theorem weakReach_iff_of_flip {θ η : Orientation D} (h : Flip D θ η) (u v : Fin n) :
    WeakReach θ u v ↔ WeakReach η u v := by
  rcases h with h | h
  · exact weakReach_iff_of_directedFlip h.some u v
  · exact (weakReach_iff_of_directedFlip h.some u v).symm

theorem weakReach_iff_of_reachable {θ η : Orientation D}
    (h : Relation.ReflTransGen (Flip D) θ η) (u v : Fin n) :
    WeakReach θ u v ↔ WeakReach η u v := by
  induction h with
  | refl => exact Iff.rfl
  | tail _ hstep ih => exact ih.trans (weakReach_iff_of_flip hstep u v)

theorem selectedConnected_iff_of_reachable {θ η : Orientation D}
    (h : Relation.ReflTransGen (Flip D) θ η) : SelectedConnected θ ↔ SelectedConnected η := by
  constructor
  · intro hc u v
    exact (weakReach_iff_of_reachable h u v).mp (hc u v)
  · intro hc u v
    exact (weakReach_iff_of_reachable h u v).mpr (hc u v)

end VerticalStripLLT.Circular.DiagramProof
