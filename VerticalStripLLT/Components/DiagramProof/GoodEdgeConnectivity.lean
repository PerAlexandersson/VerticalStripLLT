import VerticalStripLLT.Components.DiagramProof.GoodEdges
import VerticalStripLLT.Components.DiagramProof.CliqueEdges

/-! The good-edge diagram has the same weak connections as the natural diagram. -/

namespace VerticalStripLLT.Circular.DiagramProof

open Classical

noncomputable section

variable {n : ℕ} {D : Diagram n}

namespace CornerFamily

variable (F : CornerFamily D) (hforward : Forward D)

/-- Endpoint relation generated by the finite set of good edges. -/
def goodEdgeRelation : Fin n → Fin n → Prop := fun u v =>
  ∃ e ∈ F.goodEdges hforward, e.tail = u ∧ e.head = v

theorem eqvGen_goodEdgeRelation_of_natural_edge (e : Edge D.area) :
    Relation.EqvGen (F.goodEdgeRelation hforward) e.tail e.head := by
  by_cases heF : e ∈ F.edges
  · apply Relation.EqvGen.rel
    exact ⟨e, (F.mem_goodEdges hforward e).mpr (Or.inl heF), rfl, rfl⟩
  · rcases lt_trichotomy (F.terminal hforward e.tail)
      (F.terminal hforward e.head) with hlt | heq | hgt
    · apply Relation.EqvGen.rel
      exact ⟨e, (F.mem_goodEdges hforward e).mpr (Or.inr hlt), rfl, rfl⟩
    · exact (heF ((F.terminal_eq_iff_mem hforward e).mp heq)).elim
    · obtain ⟨z, hstep, heh, hterm⟩ :=
        F.successor_of_inversion hforward e hgt
      obtain ⟨c, hc, hct, hch⟩ := (F.step_iff _ _).mp hstep
      obtain ⟨f, hft, hfh⟩ := exists_edge_of_naturalLift_of_le
        (D.naturalLift_of_tail_lt_head c (hforward c))
        (by rw [hct]; exact (hforward e).le) heh (by rw [hch])
      have hgood_c : F.GoodEdge hforward c := Or.inl hc
      have hgood_f : F.GoodEdge hforward f := Or.inr (by
        rw [hft, hfh, hterm]
        exact hgt)
      apply Relation.EqvGen.trans _ _ _
        (Relation.EqvGen.rel _ _ ⟨c, (F.mem_goodEdges hforward c).mpr hgood_c,
          hct, hch⟩)
      apply Relation.EqvGen.symm
      exact Relation.EqvGen.rel _ _ ⟨f, (F.mem_goodEdges hforward f).mpr hgood_f,
        hft, hfh⟩

theorem eqvGen_goodEdgeRelation_iff_eqvGen_naturalRel (u v : Fin n) :
    Relation.EqvGen (F.goodEdgeRelation hforward) u v ↔
      Relation.EqvGen (naturalRel D) u v := by
  constructor
  · intro h
    apply Relation.EqvGen.mono (r := F.goodEdgeRelation hforward) _ _ _ h
    intro x y hxy
    rcases hxy with ⟨e, _, rfl, rfl⟩
    exact ⟨e, rfl, rfl⟩
  · intro h
    induction h with
    | refl => exact Relation.EqvGen.refl _
    | rel _ _ hxy =>
        rcases hxy with ⟨e, rfl, rfl⟩
        exact F.eqvGen_goodEdgeRelation_of_natural_edge hforward e
    | symm _ _ _ ih => exact Relation.EqvGen.symm _ _ ih
    | trans _ _ _ _ _ ih₁ ih₂ => exact Relation.EqvGen.trans _ _ _ ih₁ ih₂

end CornerFamily

end

end VerticalStripLLT.Circular.DiagramProof
