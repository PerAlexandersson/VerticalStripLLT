import VerticalStripLLT.Components.ComponentCoefficient
import VerticalStripLLT.Circular.ComponentSemantics
import Mathlib.Data.Fintype.EquivFin

/-! Quotienting the finite orientation sum by complete circular flip components. -/

namespace VerticalStripLLT.Circular

open Classical
open scoped BigOperators

noncomputable section

variable {n : ℕ} {D : Diagram n}

/-- The equivalence relation generated by the undirected circular flips. -/
def componentSetoid (D : Diagram n) : Setoid (Orientation D) where
  r θ η := Relation.ReflTransGen (Flip D) θ η
  iseqv := {
    refl := fun _ => Relation.ReflTransGen.refl
    symm := fun {_ _} h => flip_reachable_symm h
    trans := fun {_ _ _} h₁ h₂ => h₁.trans h₂
  }

/-- The finite type of complete circular flip components. -/
abbrev componentClass (D : Diagram n) := Quotient (componentSetoid D)

noncomputable instance componentClass_fintype (D : Diagram n) :
    Fintype (componentClass D) := Fintype.ofFinite _

/-- The coefficient attached to a complete component. -/
noncomputable def componentWeight (D : Diagram n) (γ : Orientation D)
    (q : componentClass D) : ℤ :=
  Quotient.lift (componentCoefficient D γ)
    (fun θ η h => componentCoefficient_eq_of_reachable γ h) q

@[simp]
theorem componentWeight_mk (γ θ : Orientation D) :
    componentWeight D γ (Quotient.mk (componentSetoid D) θ) =
      componentCoefficient D γ θ := by
  simp [componentWeight]

/-- Membership in a quotient class is membership in its representative's full component. -/
theorem componentClass_mk_eq_iff_mem (q : componentClass D) (θ : Orientation D) :
    Quotient.mk (componentSetoid D) θ = q ↔ θ ∈ flipComponent D q.out := by
  rw [Quotient.mk_eq_iff_out, mem_flipComponent_iff]
  change Relation.ReflTransGen (Flip D) θ q.out ↔ Relation.ReflTransGen (Flip D) q.out θ
  exact ⟨flip_reachable_symm, flip_reachable_symm⟩

private theorem componentClass_fiber_eq_flipComponent (q : componentClass D) :
    Finset.univ.filter (fun θ : Orientation D =>
      Quotient.mk (componentSetoid D) θ = q) = flipComponent D q.out := by
  ext θ
  simp only [Finset.mem_filter, Finset.mem_univ, true_and, componentClass_mk_eq_iff_mem]

/-- The orientation sum groups by the complete circular flip components. -/
theorem sum_componentCoefficient_smul {M : Type*} [AddCommGroup M]
    (γ : Orientation D) (value : Orientation D → M) :
    (∑ θ : Orientation D, componentCoefficient D γ θ • value θ) =
      ∑ q : componentClass D, componentWeight D γ q •
        ∑ θ ∈ flipComponent D q.out, value θ := by
  classical
  let mk : Orientation D → componentClass D := Quotient.mk (componentSetoid D)
  calc
    (∑ θ : Orientation D, componentCoefficient D γ θ • value θ) =
        ∑ θ : Orientation D, componentWeight D γ (mk θ) • value θ := by
      apply Finset.sum_congr rfl
      intro θ hθ
      simp [mk]
    _ = ∑ q : componentClass D, ∑ θ ∈ Finset.univ.filter (fun θ => mk θ = q),
          componentWeight D γ (mk θ) • value θ := by
      symm
      exact Finset.sum_fiberwise Finset.univ mk
        (fun θ => componentWeight D γ (mk θ) • value θ)
    _ = ∑ q : componentClass D, ∑ θ ∈ Finset.univ.filter (fun θ => mk θ = q),
          componentWeight D γ q • value θ := by
      apply Finset.sum_congr rfl
      intro q hq
      apply Finset.sum_congr rfl
      intro θ hθ
      rw [(Finset.mem_filter.mp hθ).2]
    _ = ∑ q : componentClass D, componentWeight D γ q •
          ∑ θ ∈ Finset.univ.filter (fun θ => mk θ = q), value θ := by
      apply Finset.sum_congr rfl
      intro q hq
      rw [← Finset.smul_sum]
    _ = ∑ q : componentClass D, componentWeight D γ q •
          ∑ θ ∈ flipComponent D q.out, value θ := by
      apply Finset.sum_congr rfl
      intro q hq
      rw [componentClass_fiber_eq_flipComponent (D := D) q]

end

end VerticalStripLLT.Circular
