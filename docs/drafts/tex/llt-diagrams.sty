\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{llt-diagrams}[2026/10/01 LLT diagrams as restricted sums]
\RequirePackage{tikz}
\RequirePackage{xparse}
\RequirePackage{amsmath}
\usetikzlibrary{decorations.pathmorphing}

% A diagram denotes a sum over the selections satisfying its restrictions.
% The surrounding text specifies the ambient diagram, exterior, and valuation.
% Positions in the ordered label list are numbered from 1, independently of labels.
% Gray denotes pairs outside the natural path. It never encodes q-weights.
% Consecutive vertices share steps; a zigzag suppresses an arbitrary interval.
\definecolor{lltExteriorGray}{RGB}{238,238,238}
\newif\ifllt@weighted
\pgfkeys{/llt/.is family,/llt/.cd,
  cell size/.store in=\llt@unit,
  label font/.store in=\llt@labelfont,
  entry font/.store in=\llt@entryfont,
  condition/.store in=\llt@condition,
  name/.store in=\llt@name,
  gaps/.store in=\llt@gaps,
  gap size/.store in=\llt@gapsize,
  gaps={},gap size=1.2,
  weighted/.is if=llt@weighted,
  weighted/.default=true,
  cell size=5.8mm,
  label font=\scriptsize,
  entry font=\small,
  condition={},name={},weighted=false}
\NewDocumentCommand{\LLTDiagramSetup}{m}{\pgfkeys{/llt/.cd,#1}}

\ExplSyntaxOn
\cs_new:Npn \lltcountlabels #1 { \clist_count:n {#1} }
\ExplSyntaxOff

% Bounds shared by entries and exterior shading.
\newcommand{\llt@checkcell}[2]{%
  \ifnum#1<1 \PackageError{llt-diagrams}{Cell column must be positive}{}\fi
  \ifnum#1<#2\else
    \PackageError{llt-diagrams}{A cell must have column < row}{}%
  \fi
  \ifnum#2>\llt@count
    \PackageError{llt-diagrams}{Cell row exceeds the label count}{}%
  \fi
}
\newcommand{\llt@cell}[3]{%
  \llt@checkcell{#1}{#2}%
  \edef\llt@cx{\csname llt@pos@#1\endcsname}%
  \edef\llt@cy{\csname llt@pos@#2\endcsname}%
  \path[fill=white] (\llt@cx+.08,\llt@cy+.08) rectangle +(.84,.84);
  \node[font=\llt@entryfont,inner sep=0pt]
    at (\llt@cx+.5,\llt@cy+.5) {$#3$};%
}

% Optional natural edge; selection contributes q only in weighted mode.
\NewDocumentCommand{\LLTOptional}{m m}{%
  \llt@cell{#1}{#2}{}%
}
% Selected normal edge; a star additionally requires it to be a cover.
\NewDocumentCommand{\LLTSelected}{s m m}{%
  \llt@cell{#2}{#3}{\IfBooleanTF{#1}{\underline{1}}{1}}%
}
% Natural normal edge present in the diagram but absent from the selection.
\NewDocumentCommand{\LLTAbsent}{m m}{%
  \llt@cell{#1}{#2}{0}%
}
% No natural edge. This changes the ambient diagram, not just the selection.
\NewDocumentCommand{\LLTForbidden}{m m}{%
  \llt@checkcell{#1}{#2}%
  \edef\llt@cx{\csname llt@pos@#1\endcsname}%
  \edef\llt@cy{\csname llt@pos@#2\endcsname}%
  \path[fill=lltExteriorGray]
    (\llt@cx,\llt@cy) rectangle +(1,1);%
}
% Strict natural edge: required selected, with no factor q.
% A star additionally requires it to be a cover in the full selected relation.
\NewDocumentCommand{\LLTStrict}{s m m}{%
  \llt@cell{#2}{#3}
    {\IfBooleanTF{#1}{\underline{\rightarrow}}{\rightarrow}}%
}
% Custom mathematical restriction; its meaning must be defined in the text.
\NewDocumentCommand{\LLTCell}{m m m}{%
  \llt@cell{#1}{#2}{#3}%
}

% Unspecified off-diagonal cells are optional NATURAL edges.
% An omitted exterior vertex does not impose absence on its incident edges.
\NewDocumentCommand{\LLTDiagram}{O{} m +m}{%
  \begingroup
  \pgfkeys{/llt/.cd,#1}%
  \edef\llt@count{\lltcountlabels{#2}}%
  \ifnum\llt@count<1
    \PackageError{llt-diagrams}{A diagram needs at least one vertex label}{}%
  \fi
  % Coordinates distinguish consecutive vertices from omitted intervals.
  \def\llt@offset{0}%
  \foreach \lab [count=\row] in {#2} {%
    \pgfmathsetmacro{\pos}{\row-1+\llt@offset}%
    \expandafter\xdef\csname llt@pos@\row\endcsname{\pos}%
    \foreach \gap in \llt@gaps {%
      \ifnum\gap=\row
        \pgfmathparse{\llt@offset+\llt@gapsize}%
        \xdef\llt@offset{\pgfmathresult}%
      \fi}%
  }%
  \pgfmathsetmacro{\llt@extent}{\csname llt@pos@\llt@count\endcsname+1}%
  \begin{tikzpicture}[x=\llt@unit,y=\llt@unit,baseline=(lltcenter),
    llt continuation/.style={decorate,decoration={zigzag,
      segment length=1.1mm,amplitude=.16mm},line width=.4pt}]
    \coordinate (lltcenter) at (\llt@extent/2,\llt@extent/2);
    \foreach \lab [count=\row] in {#2} {
      \edef\pos{\csname llt@pos@\row\endcsname}%
      \draw[line width=.55pt] (\pos,\pos) -- (\pos,\pos+1)
        -- (\pos+1,\pos+1);
      \node[font=\llt@labelfont,inner sep=0pt]
        at (\pos+.5,\pos+.5) {$\lab$};
      \ifnum\row<\llt@count
        \pgfmathtruncatemacro{\next}{\row+1}%
        \edef\nextpos{\csname llt@pos@\next\endcsname}%
        \pgfmathparse{\nextpos>\pos+1.01}%
        \ifdim\pgfmathresult pt>0pt
          \draw[llt continuation] (\pos+1,\pos+1) -- (\nextpos,\nextpos);
        \fi
      \fi
    }
    #3%
    \ifx\llt@name\empty\else
      \node[anchor=south,font=\small,inner sep=3pt]
        at (\llt@extent/2,\llt@extent) {$\llt@name$};
    \fi
    \ifx\llt@condition\empty\else
      \node[anchor=north,font=\scriptsize,inner sep=4pt]
        at (\llt@extent/2,0) {$\llt@condition$};
    \fi
  \end{tikzpicture}%
  \endgroup
}

% Ordinary area sequence: shade the exterior and draw the path boundary.
% The final argument imposes additional restrictions with the usual commands.
\NewDocumentCommand{\LLTAreaDiagram}{O{} m m +m}{%
  \ifnum\lltcountlabels{#2}=\lltcountlabels{#3}\else
    \PackageError{llt-diagrams}{Label and area counts must agree}{}%
  \fi
  \LLTDiagram[#1]{#2}{%
    \foreach \area [count=\row,remember=\area as \previous (initially 0)] in {#3} {
      \ifnum\area<0
        \PackageError{llt-diagrams}{Area entries must be nonnegative integers}{}%
      \fi
      \ifnum\area<\row\else
        \PackageError{llt-diagrams}{Area entry exceeds its vertex index}{}%
      \fi
      \ifnum\area>\numexpr\previous+1\relax
        \PackageError{llt-diagrams}{Area growth exceeds one}{}%
      \fi
      \pgfmathtruncatemacro{\lastforbidden}{\row-\area-1}%
      \ifnum\lastforbidden>0
        \foreach \col in {1,...,\lastforbidden} {\LLTForbidden{\col}{\row}}%
      \fi
    }
    \draw[line width=.6pt]
      (0,0)
      \foreach \area [count=\row] in {#3} {
        -- ({\row-\area-1},\row-1) -- ({\row-\area-1},\row)
      }
      -- (\llt@count,\llt@count);
    #4}%
}

% Convenient fixed restrictions; all rendering still goes through LLTDiagram.
\NewDocumentCommand{\LLTSelectionTriangle}{O{} m m m}{%
  \LLTDiagram[gaps={1,2},#1]{#2}{%
    \LLTSelected{1}{3}%
    \ifnum#3=1 \LLTSelected{1}{2}\else\LLTAbsent{1}{2}\fi
    \ifnum#4=1 \LLTSelected{2}{3}\else\LLTAbsent{2}{3}\fi}%
}
\NewDocumentCommand{\LLTNNSource}{O{} m}{%
  \LLTDiagram[gaps={2},#1]{#2}{\LLTStrict{1}{3}}%
}
\NewDocumentCommand{\LLTNNTarget}{O{} m}{%
  \LLTDiagram[gaps={2},#1]{#2}{\LLTForbidden{1}{3}\LLTStrict{2}{3}}%
}
\NewDocumentCommand{\LLTDNSource}{O{} m}{%
  \LLTDiagram[gaps={1,3},#1]{#2}{%
    \LLTStrict{1}{2}\LLTStrict{2}{4}%
    \LLTForbidden{1}{3}\LLTForbidden{1}{4}}%
}
\NewDocumentCommand{\LLTDNTarget}{O{} m}{%
  \LLTDiagram[gaps={1,3},#1]{#2}{%
    \LLTStrict{1}{3}\LLTStrict{3}{4}%
    \LLTForbidden{1}{4}\LLTForbidden{2}{4}}%
}
\endinput
